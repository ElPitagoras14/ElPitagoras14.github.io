---
import { ChevronLeftIcon } from "lucide-react";
import ProjectDetailHeader from "@/components/projects/project-detail-header.astro";
import ProjectGallery from "@/components/projects/project-gallery";
import ProjectMetaCard from "@/components/projects/project-meta-card.astro";
import ProjectNarrative from "@/components/projects/project-narrative.astro";
import ProjectNav from "@/components/projects/project-nav.astro";
import { getProjects } from "@/data";
import { getDictionary } from "@/i18n/utils";
import Layout from "@/layouts/main.astro";
import type {
  DetailViewDict,
  LangType,
  ListViewDict,
  Project,
  TypesDict,
} from "@/lib/interfaces";

interface ProjectsPageDict {
  listView: ListViewDict;
  detailView: DetailViewDict;
  types: TypesDict;
}

export function getStaticPaths() {
  const langs: LangType[] = ["en", "es"];
  return langs.flatMap((lang) => {
    const projects = getProjects(lang);
    const d = getDictionary(lang).projectsPage as unknown as ProjectsPageDict;
    return projects.map((project) => ({
      params: { lang, slug: project.id },
      props: { project, dict: d },
    }));
  });
}

const { lang, slug } = Astro.params as { lang: LangType; slug: string };
const { project, dict } = Astro.props as {
  project: Project;
  dict: ProjectsPageDict;
};
const d = dict.detailView;
const all = getProjects(lang);
const idx = all.findIndex((p) => p.id === slug);
const prev = all[(idx - 1 + all.length) % all.length];
const next = all[(idx + 1) % all.length];

const seoTitle = project.title;
const seoDescription = project.tagline ?? project.shortDescription;
---

<Layout lang={lang} title={seoTitle} description={seoDescription} type="article">
  <div class="max-w-4xl mx-auto px-6 md:px-10 py-16 md:py-24 space-y-16">
    <a
      href={`/${lang}/projects`}
      class="inline-flex items-center gap-1.5 text-sm text-muted-foreground hover:text-foreground transition-colors"
    >
      <ChevronLeftIcon className="w-4 h-4" />
      {d.back}
    </a>

    <ProjectDetailHeader project={project} dict={d} types={dict.types} />

    <div class="relative w-full aspect-video rounded-2xl overflow-hidden ring-1 ring-foreground/10 bg-card">
      <!-- Layered gradient mesh -->
      <div aria-hidden="true" class="absolute inset-0">
        <div class="absolute -top-24 -left-24 h-[60%] w-[60%] rounded-full bg-blue-500/30 blur-[100px]"></div>
        <div class="absolute -bottom-32 -right-16 h-[70%] w-[60%] rounded-full bg-emerald-500/20 blur-[110px]"></div>
        <div class="absolute top-1/3 left-1/2 -translate-x-1/2 h-[50%] w-[40%] rounded-full bg-blue-400/15 blur-[120px]"></div>
      </div>
      <!-- Dot grid overlay -->
      <div
        aria-hidden="true"
        class="absolute inset-0 opacity-25 bg-[radial-gradient(circle_at_1px_1px,rgba(255,255,255,0.45)_1px,transparent_0)] bg-size-[22px_22px]"
      ></div>
      <!-- Title overlay -->
      <div class="absolute inset-0 flex flex-col items-center justify-center gap-3 text-center px-6">
        <span class="text-[0.7rem] uppercase tracking-[0.2em] text-blue-700 dark:text-blue-300 font-medium">
          {project.year} · {dict.types[project.type]}
        </span>
        <span class="font-mono text-3xl md:text-5xl font-semibold tracking-tight text-foreground">
          {project.id}
        </span>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-[2fr_1fr] gap-10 items-start">
      <ProjectNarrative project={project} dict={d} />
      <ProjectMetaCard project={project} dict={d} types={dict.types} />
    </div>

    {project.gallery && project.gallery.length > 0 && (
      <ProjectGallery
        client:visible
        images={project.gallery}
        title={d.gallery}
      />
    )}

    <ProjectNav prev={prev} next={next} lang={lang} dict={d} />
  </div>
</Layout>
