---
import ContactForm from "@/components/contact/contact-form.tsx";
import ContactInfo from "@/components/contact/contact-info.astro";
import { getDictionary } from "@/i18n/utils";
import Main from "@/layouts/main.astro";

export function getStaticPaths() {
  return [{ params: { lang: "en" } }, { params: { lang: "es" } }];
}

const { lang } = Astro.params;
const dict = getDictionary(lang as "en" | "es");
const d = dict.contactPage;

const seoTitle = lang === "es" ? "Contacto" : "Contact";
const seoDescription =
  lang === "es"
    ? "Conversemos. Abierto a roles full-time y proyectos freelance. Respuesta en menos de 48 horas."
    : "Let's talk. Open to full-time roles and freelance projects. Response in under 48 hours.";
---

<Main lang={lang} title={seoTitle} description={seoDescription}>
  <div class="max-w-5xl mx-auto px-6 md:px-10 py-16 md:py-24 space-y-16">
    <!-- Header -->
    <div class="space-y-4 max-w-3xl">
      <p class="text-xs uppercase tracking-[0.2em] text-blue-600 dark:text-blue-400 font-medium">
        {d.header.label}
      </p>
      <h1 class="text-3xl md:text-5xl font-semibold tracking-tight leading-tight">{d.header.title}</h1>
      <p class="text-sm md:text-base text-muted-foreground leading-relaxed">
        {d.header.subtitle}
      </p>
    </div>

    <!-- Body: form + info panel -->
    <div class="grid grid-cols-1 md:grid-cols-[3fr_2fr] gap-12 md:gap-20 items-start">
      <ContactForm client:load dict={d.form} />
      <ContactInfo dict={d.info} />
    </div>
  </div>
</Main>
