---
import { Badge } from "@/components/ui/badge";
import { getSkills } from "@/data";
import { getDictionary } from "@/i18n/utils";
import type { LangType } from "@/lib/interfaces";

interface Props {
  lang: LangType;
}

const { lang } = Astro.props;
const dict = getDictionary(lang);
const section = dict.aboutPage.skillsSection;
const categories = getSkills(lang);
---

<div class="space-y-6">
  <div class="space-y-3">
    <p class="text-xs uppercase tracking-[0.2em] text-blue-600 dark:text-blue-400 font-medium">{section.label}</p>
    <h2 class="text-2xl md:text-3xl font-semibold tracking-tight">{section.title}</h2>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
    {
      categories.map((category) => (
        <div>
          <h4 class="text-xs uppercase tracking-widest text-muted-foreground mb-3">
            {category.title}
          </h4>
          <div class="flex flex-wrap gap-2">
            {category.skills.map((skill) => (
              <Badge variant="tech" className="h-7 px-2.5 text-xs">{skill}</Badge>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</div>
