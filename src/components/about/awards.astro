---
import { ExternalLink } from "lucide-react";
import { getDictionary } from "@/i18n/utils";
import type { LangType } from "@/lib/interfaces";

interface Props {
  lang: LangType;
}

const { lang } = Astro.props;
const dict = getDictionary(lang);
const section = dict.aboutPage.awardsSection;
---

<div class="space-y-6">
  <!-- Section header — plain style -->
  <div class="space-y-3">
    <p class="text-xs uppercase tracking-[0.2em] text-blue-600 dark:text-blue-400 font-medium">{section.label}</p>
    <h2 class="text-2xl md:text-3xl font-semibold tracking-tight">{section.title}</h2>
  </div>

  <!-- Two-column grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
    <!-- Awards column -->
    <div>
      <h3 class="text-base font-semibold tracking-tight mb-4">{section.awardsTitle}</h3>
      <div class="flex flex-col">
        {
          section.awards.map((award) => (
            <div class="border-b border-border py-4">
              <p class="text-sm md:text-base font-medium">{award.title}</p>
              <p class="text-xs uppercase tracking-[0.15em] text-muted-foreground/80 font-mono mt-1">
                {award.issuer} · {award.date}
              </p>
            </div>
          ))
        }
      </div>
    </div>

    <!-- Certifications column -->
    <div>
      <h3 class="text-base font-semibold tracking-tight mb-4">{section.certificationsTitle}</h3>
      <div class="flex flex-col">
        {
          section.certifications.map((cert) => (
            <div class="border-b border-border py-4">
              <div class="flex items-center gap-1.5">
                <p class="text-sm md:text-base font-medium">{cert.title}</p>
                {"url" in cert && cert.url ? (
                  <a
                    href={cert.url as string}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-accent hover:opacity-70 transition-opacity"
                  >
                    <ExternalLink className="size-3.5" />
                  </a>
                ) : null}
              </div>
              <p class="text-xs uppercase tracking-[0.15em] text-muted-foreground/80 font-mono mt-1">
                {cert.issuer} · {cert.date}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</div>
