---
import { getDictionary } from "@/i18n/utils";
import type { LangType } from "@/lib/interfaces";
import { Button } from "../ui/button";

const { lang } = Astro.params as { lang: LangType };
const dict = getDictionary(lang);
const section = dict.homePage.contactSection;
---

<div
  class="flex flex-col space-y-6 mx-auto text-center justify-center items-center"
>
  <p
    class="text-2xl md:text-4xl font-semibold tracking-tight max-w-2xl leading-tight"
  >
    {section.title}
  </p>
  <p
    class="text-sm md:text-base text-muted-foreground max-w-xl leading-relaxed"
  >
    {section.description}
  </p>
  <div class="flex flex-col md:flex-row justify-center gap-3 md:gap-4 pt-2">
    <a href={`/${lang}/contact`}>
      <Button size="lg">{section.cta}</Button>
    </a>
    <a
      href="https://rxresu.me/elpitagoras14/software-engineer-en"
      target="_blank"
      rel="noopener noreferrer"
    >
      <Button variant="outline" size="lg">{section.resumeCta}</Button>
    </a>
  </div>
</div>
