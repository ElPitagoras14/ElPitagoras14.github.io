---
import type { DetailViewDict, Project } from "@/lib/interfaces";

interface Props {
  project: Project;
  dict: DetailViewDict;
}

const { project, dict } = Astro.props;

const sections = [
  { title: dict.sections.problem, body: project.narrative.problem },
  { title: dict.sections.approach, body: project.narrative.approach },
  { title: dict.sections.learned, body: project.narrative.learned },
];
---

<div class="space-y-10 max-w-prose">
  {sections.map((section) => (
    <div class="space-y-3">
      <h3 class="text-xs uppercase tracking-[0.2em] text-blue-600 dark:text-blue-400 font-medium">{section.title}</h3>
      <p class="text-sm md:text-base text-muted-foreground leading-relaxed">{section.body}</p>
    </div>
  ))}
</div>
