---
import { Badge } from "@/components/ui/badge";
import { Card, CardContent } from "@/components/ui/card";
import type { DetailViewDict, Project } from "@/lib/interfaces";

interface Props {
  prev: Project;
  next: Project;
  lang: string;
  dict: DetailViewDict;
}

const { prev, next, lang, dict } = Astro.props;
---

<div class="grid grid-cols-1 md:grid-cols-2 gap-4 border-t border-foreground/10 pt-10">
  <a href={`/${lang}/projects/${prev.id}`} class="block group">
    <Card className="h-full py-5 hover:ring-blue-400/30">
      <CardContent className="px-6 space-y-3">
        <p class="text-[0.7rem] uppercase tracking-[0.18em] text-blue-600 dark:text-blue-400 font-medium">
          ← {dict.prevProject}
        </p>
        <p class="text-xl font-semibold tracking-tight group-hover:text-blue-300 transition-colors">{prev.title}</p>
        <p class="text-xs font-mono text-muted-foreground">{prev.year}</p>
        <div class="flex flex-wrap gap-1.5">
          {prev.stack.slice(0, 3).map((tech) => (
            <Badge variant="tech" className="px-2 py-0.5">{tech}</Badge>
          ))}
        </div>
      </CardContent>
    </Card>
  </a>
  <a href={`/${lang}/projects/${next.id}`} class="block group">
    <Card className="h-full py-5 hover:ring-blue-400/30">
      <CardContent className="px-6 space-y-3 text-right">
        <p class="text-[0.7rem] uppercase tracking-[0.18em] text-blue-600 dark:text-blue-400 font-medium">
          {dict.nextProject} →
        </p>
        <p class="text-xl font-semibold tracking-tight group-hover:text-blue-300 transition-colors">{next.title}</p>
        <p class="text-xs font-mono text-muted-foreground">{next.year}</p>
        <div class="flex flex-wrap gap-1.5 justify-end">
          {next.stack.slice(0, 3).map((tech) => (
            <Badge variant="tech" className="px-2 py-0.5">{tech}</Badge>
          ))}
        </div>
      </CardContent>
    </Card>
  </a>
</div>
